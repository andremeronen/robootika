#include <Servo.h>

//defineerib ära neid osa mida vajab läheb
#define pinServo 3
#define pinButt1 4
#define pinButt2 5
#define pinButt3 6

//Paneb paika mis on esimene nupp jne.
Servo myServo;
void setup() {
  myServo.attach(pinServo);
  
  pinMode( pinButt1,INPUT );
  pinMode( pinButt2,INPUT );
  pinMode( pinButt3,INPUT );
}

//Kui vajutad ühte nendest nupudest siis pöörab mootor niipalju
void loop() {
  if ( digitalRead(pinButt1) ==1 ) myServo.write(90);
  if ( digitalRead(pinButt2) ==1 ) myServo.write(180);
  if ( digitalRead(pinButt3) ==1 ) myServo.write(360);
  delay(15);
}

